root = true

[*.{kt,kts}]
end_of_line = lf
ktlint_code_style = ktlint_official
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
compose_allowed_composition_locals = LocalFinoteColors,LocalFinoteBrushes,LocalIsDark,LocalFinoteTypography,LocalFinoteSpacing,LocalFinoteSizes,LocalFinoteRadii,LocalFinoteShapes,LocalFinoteMotion
ktlint_compose_preview-annotation-naming = disabled

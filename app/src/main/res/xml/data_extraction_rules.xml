<?xml version="1.0" encoding="utf-8"?>
<!-- The database is encrypted and the Keystore key never leaves the device, so a restored copy cannot be opened. -->
<!-- rule_update.xml holds the download switch: a restored ON would download without a fresh choice. -->
<!-- app_setup.xml holds the setup-done flag: a restored flag would skip setup on top of an empty database. -->
<!-- drift_ack.xml holds drift acknowledgements keyed to the ledger: a restored one would hide a real drift. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="db_key.xml" />
        <exclude domain="sharedpref" path="rule_update.xml" />
        <exclude domain="sharedpref" path="app_setup.xml" />
        <exclude domain="sharedpref" path="drift_ack.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="db_key.xml" />
        <exclude domain="sharedpref" path="rule_update.xml" />
        <exclude domain="sharedpref" path="app_setup.xml" />
        <exclude domain="sharedpref" path="drift_ack.xml" />
    </device-transfer>
</data-extraction-rules>

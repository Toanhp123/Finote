<?xml version="1.0" encoding="utf-8"?>
<!-- The database is encrypted and the Keystore key never leaves the device, so a restored copy cannot be opened. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="db_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="db_key.xml" />
    </device-transfer>
</data-extraction-rules>
